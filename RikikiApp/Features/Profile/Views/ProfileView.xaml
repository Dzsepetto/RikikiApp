<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RikikiApp.Features.Profile.Views.ProfileView">

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="16,20">

            <!-- PROFILE CARD -->
            <Grid HeightRequest="195"
                  HorizontalOptions="Fill">

                <!-- Photoshop card background -->
                <Image Source="prof_card_bg.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"
                       InputTransparent="True"/>

                <!-- Card content -->
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      Padding="35,18,35,20">

                    <!-- Profile image -->
                    <Frame Grid.Row="0"
                           Grid.ColumnSpan="2"
                           HeightRequest="65"
                           WidthRequest="65"
                           CornerRadius="33"
                           Padding="0"
                           HasShadow="False"
                           BackgroundColor="#ddd"
                           HorizontalOptions="Center">

                        <Image Source="{Binding ProfileImage}"
                               Aspect="AspectFill"/>
                    </Frame>

                    <!-- Username -->
                    <Entry Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           x:Name="UserNameEntry"
                           Text="{Binding EditableUserName}"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#171717"
                           BackgroundColor="Transparent"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           WidthRequest="190"
                           IsReadOnly="{Binding IsNameReadOnly}"
                           Margin="0,0,0,0"/>

                    <!-- Edit / Save button -->
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding EditButtonText}"
                            Command="{Binding EditOrSavePlayerCommand}"
                            BackgroundColor="#222222"
                            TextColor="White"
                            FontSize="12"
                            CornerRadius="20"
                            WidthRequest="55"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            VerticalOptions="Start"/>

                    <!-- Login message -->
                    <Label Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="{Binding NeedsToLoginTxt}"
                           TextColor="#D71935"
                           FontSize="11"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"/>

                </Grid>
            </Grid>

            <!-- STATS -->
            <Border BackgroundColor="#FFF9ED"
                    Stroke="#D8CDBB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="15">

                <Grid ColumnDefinitions="*,*,*">

                    <!-- WINS -->
                    <VerticalStackLayout Grid.Column="0"
                                         HorizontalOptions="Center"
                                         Spacing="4">

                        <Label Text="🏆"
                               FontSize="26"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{Binding Wins}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Wins"
                               FontSize="12"
                               TextColor="#444444"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                    <!-- LOSSES -->
                    <VerticalStackLayout Grid.Column="1"
                                         HorizontalOptions="Center"
                                         Spacing="4">

                        <Label Text="✕"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="#D71935"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{Binding Losses}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Losses"
                               FontSize="12"
                               TextColor="#444444"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                    <!-- GAMES -->
                    <VerticalStackLayout Grid.Column="2"
                                         HorizontalOptions="Center"
                                         Spacing="4">

                        <Label Text="🃏"
                               FontSize="26"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{Binding TotalGames}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="Games"
                               FontSize="12"
                               TextColor="#444444"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- ACTION BUTTONS -->
            <VerticalStackLayout Spacing="12">

                <Button Text="♟   Players"
                        Command="{Binding MoveToPlayersCommand}"
                        BackgroundColor="{StaticResource AccentGreen}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="52"/>

                <Button Text="⚙   Settings"
                        BackgroundColor="#FFF9ED"
                        TextColor="#202020"
                        CornerRadius="12"
                        HeightRequest="52"
                        IsEnabled="False"/>

                <Button Text="⇥   Login / Logout"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#FFF9ED"
                        TextColor="#202020"
                        CornerRadius="12"
                        HeightRequest="52"
                        IsEnabled="False"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>