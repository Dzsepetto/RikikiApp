<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RikikiApp.Features.Games.Views.GamePlayView">

    <Grid
        Padding="18,16,18,12"
        RowDefinitions="Auto,*"
        RowSpacing="16"
        BackgroundColor="Transparent">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="44,*,44"
            ColumnSpacing="10">

            <Button
                Grid.Column="0"
                Text="←"
                Command="{Binding BackCommand}"
                BackgroundColor="{StaticResource AccentGreen}"
                TextColor="White"
                FontSize="22"
                CornerRadius="13"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0" />

            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="3">

                <Label
                    Text="{Binding RoundText}"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />

                <Label
                    Text="RIKIKI GAME"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="#C7E4D2"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>

        <!-- SCROLLABLE CONTENT -->
        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Spacing="16"
                Padding="0,0,0,14">

                <!-- CALLS / GAME PANEL -->
                <Border
                    IsVisible="{Binding IsGameVisible}"
                    BackgroundColor="#FFF9ED"
                    Stroke="#D8CDBB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">

                    <VerticalStackLayout Spacing="13">

                        <!-- SECTION HEADER -->
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            Padding="3,2">

                            <Label
                                Grid.Column="0"
                                Text="♠"
                                FontSize="25"
                                TextColor="#08743B"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="Players &amp; Calls"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#202020"
                                VerticalOptions="Center" />

                        </Grid>

                        <!-- PLAYER CARDS -->
                        <VerticalStackLayout
                            Spacing="10"
                            BindableLayout.ItemsSource="{Binding Calls}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        BackgroundColor="White"
                                        Stroke="#E6DCCB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 13"
                                        Padding="12">

                                        <VerticalStackLayout Spacing="12">

                                            <!-- PLAYER NAME -->
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="9">

                                                <Border
                                                    Grid.Column="0"
                                                    BackgroundColor="#E7F0E4"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 9"
                                                    WidthRequest="34"
                                                    HeightRequest="34">

                                                    <Label
                                                        Text="♣"
                                                        FontSize="20"
                                                        TextColor="#08743B"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center" />

                                                </Border>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding PlayerName}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="#202020"
                                                    VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation" />

                                            </Grid>

                                            <!-- CALL / WON CONTROLS -->
                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="14">

                                                <!-- CALLED -->
                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="8">

                                                    <Label
                                                        Text="CALLED"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        CharacterSpacing="1"
                                                        TextColor="#788178" />

                                                    <Grid
                                                        ColumnDefinitions="38,*,38"
                                                        ColumnSpacing="4">

                                                        <Button
                                                            Grid.Column="0"
                                                            Text="−"
                                                            Command="{Binding DecreaseCallCommand}"
                                                            BackgroundColor="#E9EDE8"
                                                            TextColor="#202020"
                                                            FontSize="22"
                                                            FontAttributes="Bold"
                                                            CornerRadius="10"
                                                            WidthRequest="38"
                                                            HeightRequest="42"
                                                            Padding="0" />

                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding Called}"
                                                            FontSize="20"
                                                            FontAttributes="Bold"
                                                            TextColor="#202020"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center" />

                                                        <Button
                                                            Grid.Column="2"
                                                            Text="+"
                                                            Command="{Binding IncreaseCallCommand}"
                                                            BackgroundColor="#128B47"
                                                            TextColor="White"
                                                            FontSize="22"
                                                            FontAttributes="Bold"
                                                            CornerRadius="10"
                                                            WidthRequest="38"
                                                            HeightRequest="42"
                                                            Padding="0" />

                                                    </Grid>

                                                </VerticalStackLayout>

                                                <!-- WON -->
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="8"
                                                    IsVisible="{Binding IsWonVisible}">

                                                    <Label
                                                        Text="WON"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        CharacterSpacing="1"
                                                        TextColor="#788178" />

                                                    <Grid
                                                        ColumnDefinitions="38,*,38"
                                                        ColumnSpacing="4">

                                                        <Button
                                                            Grid.Column="0"
                                                            Text="−"
                                                            Command="{Binding DecreaseWonCommand}"
                                                            BackgroundColor="#E9EDE8"
                                                            TextColor="#202020"
                                                            FontSize="22"
                                                            FontAttributes="Bold"
                                                            CornerRadius="10"
                                                            WidthRequest="38"
                                                            HeightRequest="42"
                                                            Padding="0" />

                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding Won}"
                                                            FontSize="20"
                                                            FontAttributes="Bold"
                                                            TextColor="#202020"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center" />

                                                        <Button
                                                            Grid.Column="2"
                                                            Text="+"
                                                            Command="{Binding IncreaseWonCommand}"
                                                            BackgroundColor="#128B47"
                                                            TextColor="White"
                                                            FontSize="22"
                                                            FontAttributes="Bold"
                                                            CornerRadius="10"
                                                            WidthRequest="38"
                                                            HeightRequest="42"
                                                            Padding="0" />

                                                    </Grid>

                                                </VerticalStackLayout>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- ROUND RESULTS -->
                <Border
                    IsVisible="{Binding IsResultVisible}"
                    BackgroundColor="#FFF9ED"
                    Stroke="#D8CDBB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">

                    <VerticalStackLayout Spacing="14">

                        <!-- HEADER -->
                        <HorizontalStackLayout
                            Spacing="10"
                            Padding="3,0">

                            <Label
                                Text="♦"
                                FontSize="25"
                                TextColor="#B82730"
                                VerticalOptions="Center" />

                            <Label
                                Text="Round Results"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#202020"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <!-- COLUMN HEADERS -->
                        <Grid
                            ColumnDefinitions="*,45,45,55"
                            ColumnSpacing="5"
                            Padding="8,0">

                            <Label
                                Grid.Column="0"
                                Text="PLAYER"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#788178" />

                            <Label
                                Grid.Column="1"
                                Text="CALL"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#788178"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="2"
                                Text="WON"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#788178"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="3"
                                Text="SCORE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#788178"
                                HorizontalTextAlignment="Center" />

                        </Grid>

                        <!-- RESULTS LIST -->
                        <VerticalStackLayout
                            Spacing="8"
                            BindableLayout.ItemsSource="{Binding Results}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        BackgroundColor="White"
                                        Stroke="#E6DCCB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 11"
                                        Padding="8,12">

                                        <Grid
                                            ColumnDefinitions="*,45,45,55"
                                            ColumnSpacing="5">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding PlayerName}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#202020"
                                                VerticalOptions="Center"
                                                LineBreakMode="TailTruncation" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Called}"
                                                FontSize="14"
                                                TextColor="#202020"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Won}"
                                                FontSize="14"
                                                TextColor="#202020"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />

                                            <Border
                                                Grid.Column="3"
                                                BackgroundColor="#E7F0E4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="4,6">

                                                <Label
                                                    Text="{Binding Score}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="#08743B"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center" />

                                            </Border>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- FIX CALLS BUTTON -->
                <Button
                    Text="Fix Calls"
                    Command="{Binding FixCallsCommand}"
                    IsVisible="{Binding IsFixCallsVisible}"
                    BackgroundColor="#128B47"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />

                <!-- END ROUND BUTTON -->
                <Button
                    Text="End Round"
                    Command="{Binding EndRoundCommand}"
                    IsVisible="{Binding IsEndRoundVisible}"
                    BackgroundColor="#128B47"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />

                <!-- ROUND RESULT ACTIONS -->
                <Grid
                    IsVisible="{Binding IsResultVisible}"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="10">

                    <Button
                        Grid.Column="0"
                        Text="Less"
                        Command="{Binding LessCommand}"
                        BackgroundColor="#82303C"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Padding="4,0" />

                    <Button
                        Grid.Column="1"
                        Text="Same"
                        Command="{Binding SameCommand}"
                        BackgroundColor="#59645D"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Padding="4,0" />

                    <Button
                        Grid.Column="2"
                        Text="More"
                        Command="{Binding MoreCommand}"
                        BackgroundColor="#128B47"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Padding="4,0" />

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>
</ContentView>