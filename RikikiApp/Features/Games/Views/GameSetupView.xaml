<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="RikikiApp.Features.Games.Views.GameSetupView"
    x:Name="Root">

    <Grid
        Padding="18,16,18,12"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="14"
        BackgroundColor="Transparent">

        <!-- HEADER -->
        <Grid Grid.Row="0"
              ColumnDefinitions="44,*,44"
              ColumnSpacing="10">

            <Button
                Grid.Column="0"
                Text="←"
                Command="{Binding BackCommand}"
                BackgroundColor="{StaticResource AccentGreen}"
                TextColor="White"
                FontSize="22"
                CornerRadius="13"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0" />

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="2">

                <Label
                    Text="{Binding Title}"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />

                <Label
                    Text="GAME SETUP"
                    FontSize="10"
                    TextColor="#C7E4D2"
                    CharacterSpacing="1.6"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="✕"
                Command="{Binding DeleteGameCommand}"
                BackgroundColor="#82303C"
                TextColor="White"
                FontSize="20"
                CornerRadius="13"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0" />

        </Grid>

        <!-- CENTER CONTENT -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto"
              RowSpacing="14"
              VerticalOptions="Start">

            <!-- PLAYERS PANEL -->
            <Border
                    Grid.Row="0"
                    BackgroundColor="#FFF9ED"
                    Stroke="#D8CDBB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14"
                    VerticalOptions="Start">

                <toolkit:Expander
                    x:Name="PlayersExpander"
                    IsExpanded="{Binding IsPlayersExpanded}">

                    <toolkit:Expander.Header>
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="3,6">

                            <HorizontalStackLayout
                                Grid.Column="0"
                                Spacing="10"
                                VerticalOptions="Center">

                                <Label
                                    Text="♣"
                                    FontSize="24"
                                    TextColor="#08743B"
                                    VerticalOptions="Center" />

                                <Label
                                    Text="{Binding PlayersTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#202020"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="⌄"
                                FontSize="24"
                                TextColor="#59675C"
                                VerticalOptions="Center">

                                <Label.Triggers>
                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding Source={x:Reference PlayersExpander},
                                                          Path=IsExpanded}"
                                        Value="True">
                                        <Setter Property="Rotation"
                                                Value="180" />
                                    </DataTrigger>
                                </Label.Triggers>

                            </Label>

                        </Grid>
                    </toolkit:Expander.Header>

                    <Grid RowDefinitions="Auto,*,Auto"
                          RowSpacing="7">

                        <!-- EMPTY STATE -->
                        <VerticalStackLayout
                            Grid.Row="0"
                            IsVisible="{Binding IsEmpty}"
                            Padding="12,22"
                            Spacing="6">

                            <Label
                                Text="♠"
                                FontSize="32"
                                TextColor="#91AD96"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="No players yet"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#202020"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Add players to start your game"
                                FontSize="12"
                                TextColor="#777777"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <!-- DRAGGABLE PLAYER LIST -->
                        <CollectionView
                            x:Name="PlayersList"
                            Grid.Row="1"
                            ItemsSource="{Binding Players}"
                            IsVisible="{Binding IsNotEmpty}"
                            SelectionMode="None"
                            VerticalOptions="Fill"
                            Margin="0,8,0,0">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        Margin="0,0,0,9">

                                        <!-- DROP INDICATOR -->
                                        <BoxView
                                            Grid.Row="0"
                                            HeightRequest="3"
                                            BackgroundColor="#169449"
                                            IsVisible="{Binding IsDropTarget}"
                                            HorizontalOptions="Fill" />

                                        <!-- PLAYER CARD -->
                                        <Border
                                            Grid.Row="1"
                                            BackgroundColor="White"
                                            Stroke="#E5DCCF"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="9,10">

                                            <Grid
                                                ColumnDefinitions="32,34,*,40"
                                                ColumnSpacing="8"
                                                MinimumHeightRequest="38">

                                                <Grid.GestureRecognizers>
                                                    <DropGestureRecognizer
                                                        Drop="OnDrop"
                                                        DragOver="OnDragOver"
                                                        AllowDrop="True" />
                                                </Grid.GestureRecognizers>

                                                <!-- DRAG HANDLE -->
                                                <Label
                                                    Grid.Column="0"
                                                    Text="☰"
                                                    FontSize="19"
                                                    TextColor="#8D998F"
                                                    VerticalOptions="Center"
                                                    HorizontalTextAlignment="Center">

                                                    <Label.GestureRecognizers>
                                                        <DragGestureRecognizer
                                                            DragStarting="OnDragStarting"
                                                            DropCompleted="OnDragCompleted" />
                                                    </Label.GestureRecognizers>

                                                </Label>

                                                <!-- SEAT NUMBER -->
                                                <Border
                                                    Grid.Column="1"
                                                    BackgroundColor="#E7F0E4"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 9"
                                                    WidthRequest="34"
                                                    HeightRequest="34">

                                                    <Label
                                                        Text="{Binding SeatOrder}"
                                                        TextColor="#08743B"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center" />

                                                </Border>

                                                <!-- PLAYER NAME -->
                                                <Label
                                                    Grid.Column="2"
                                                    Text="{Binding GuestName}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="#202020"
                                                    VerticalOptions="Center"
                                                    LineBreakMode="TailTruncation" />

                                                <!-- DELETE PLAYER -->
                                                <Button
                                                    Grid.Column="3"
                                                    Text="✕"
                                                    FontSize="17"
                                                    TextColor="#B82730"
                                                    BackgroundColor="#FBE8E8"
                                                    CornerRadius="10"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"
                                                    Command="{Binding Source={x:Reference Root},
                                                                      Path=BindingContext.DeletePlayerCommand}"
                                                    CommandParameter="{Binding .}" />

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <!-- DROP TO END -->
                            <CollectionView.Footer>
                                <Grid HeightRequest="35">

                                    <Grid.GestureRecognizers>
                                        <DropGestureRecognizer
                                            Drop="OnDropToEnd"
                                            AllowDrop="True" />
                                    </Grid.GestureRecognizers>

                                    <BoxView
                                        HeightRequest="3"
                                        BackgroundColor="#169449"
                                        VerticalOptions="Start"
                                        IsVisible="{Binding Source={x:Reference Root},
                                                            Path=BindingContext.IsDragging}" />

                                </Grid>
                            </CollectionView.Footer>

                        </CollectionView>

                        <!-- HINT -->
                        <Label
                            Grid.Row="2"
                            Text="☰  Drag players to change their order"
                            TextColor="#7A857D"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding IsNotEmpty}"
                            Margin="0,5,0,0" />

                    </Grid>

                </toolkit:Expander>

            </Border>

            <!-- SECONDARY ACTIONS -->
            <VerticalStackLayout
    Grid.Row="1"
    Spacing="10"
    HorizontalOptions="Fill">

                <!-- ADD PLAYER -->
                <Button
        Text="+  Add Player"
        Command="{Binding AddPlayerCommand}"
        BackgroundColor="{StaticResource AccentGreen}"
        TextColor="White"
        FontSize="14"
        FontAttributes="Bold"
        CornerRadius="12"
        HeightRequest="50"
        HorizontalOptions="Fill" />

                <!-- STATS -->
                <Button
        Text="♠  Stats"
        Command="{Binding ShowStatsCommand}"
        BackgroundColor="#FFF9ED"
        TextColor="#202020"
        FontSize="14"
        FontAttributes="Bold"
        CornerRadius="12"
        HeightRequest="50"
        HorizontalOptions="Fill" />

            </VerticalStackLayout>

        </Grid>

        <!-- PRIMARY ACTIONS -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">

            <Button
                Grid.Column="0"
                Text="End Game"
                Command="{Binding EndGameCommand}"
                BackgroundColor="#82303C"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="52" />

            <Button
                Grid.Column="1"
                Text="Start Game"
                Command="{Binding StartGameCommand}"
                BackgroundColor="{StaticResource AccentGreen}"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="52" />

        </Grid>

    </Grid>
</ContentView>